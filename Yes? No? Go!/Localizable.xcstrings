    },
    "tipjar.header.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes? No? Go! is free with no ads or subscriptions. If you find it useful, consider leaving a tip to support future development."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes? No? Go! es gratis, sin anuncios ni suscripciones. Si te resulta útil, considera dejar una propina para apoyar el desarrollo futuro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes? No? Go! est gratuit, sans pub ni abonnement. Si l’app vous est utile, pensez à laisser un pourboire pour soutenir le développement futur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes? No? Go! è gratuita, senza pubblicità né abbonamenti. Se ti è utile, valuta di lasciare una mancia per supportare lo sviluppo futuro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes? No? Go! é grátis, sem anúncios ou assinaturas. Se for útil para você, considere deixar uma gorjeta para apoiar o desenvolvimento futuro."
          }
        }
      }
    },
